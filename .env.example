# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/delivery_bid
# or for Supabase:
# SUPABASE_DATABASE_URL=postgresql://...

# ─── Session ─────────────────────────────────────────────────────────────────
SESSION_SECRET=change-me-to-a-long-random-string

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGIN=https://your-frontend.vercel.app

# ─── Web Push / VAPID ────────────────────────────────────────────────────────
# Generate a fresh pair with: node -e "const wp=require('web-push'); const k=wp.generateVAPIDKeys(); console.log(k);"
VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
# Must be an email address or URL
VAPID_SUBJECT=mailto:admin@twasalni.app
