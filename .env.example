# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/delivery_bid
# or for Supabase:
# SUPABASE_DATABASE_URL=postgresql://...

# ─── Session ─────────────────────────────────────────────────────────────────
SESSION_SECRET=change-me-to-a-long-random-string

# ─── CORS ────────────────────────────────────────────────────────────────────
# Note: https://sharq.it.com and https://www.sharq.it.com are always allowed in code.
# Add additional origins here (comma-separated) if needed.
CORS_ORIGIN=https://sharq.it.com

# ─── Web Push / VAPID ────────────────────────────────────────────────────────
# Generate a fresh pair with: node -e "const wp=require('web-push'); const k=wp.generateVAPIDKeys(); console.log(k);"
VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
# Must be an email address or URL
VAPID_SUBJECT=mailto:admin@twasalni.app

# ─── Supabase (required for Edge Function DB webhook trigger) ─────────────────
# Used by migration 005 trigger to call the send-push-notification Edge Function.
# Also set these as Edge Function Secrets in Supabase Dashboard → Project Settings.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
